# Copy to .env (mode 600) on the host that runs the stack and fill in. Never commit .env.
# Tailscale IP the port binds to; never 0.0.0.0.
WRA_BIND_IP=100.106.37.39
# Bearer token clients must send; generate a long random string. An empty value stops the launcher.
WRA_TOKEN=
# SearXNG secret key (random string); never reaches the wra container.
SEARXNG_SECRET=
# Optional rotating proxy, Evomi format http://user:pass@<evomi-host>:<port> copied from the Evomi dashboard.
PROXY_URL=
# Optional Exa API key for the Exa search provider.
EXA_API_KEY=
# Optional Pixabay API key for search_images.
PIXABAY_API_KEY=
# Search provider preference: auto, searxng or exa.
SEARCH_PROVIDER=auto
