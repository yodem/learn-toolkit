{
  "mcpServers": {
    "tavily": {
      "type": "http",
      "url": "https://mcp.tavily.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${user_config.tavily_api_key}",
        "DEFAULT_PARAMETERS": "{\"search_depth\":\"advanced\",\"chunks_per_source\":3,\"max_results\":8}"
      }
    },
    "exa": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,web_search_advanced_exa",
      "headers": { "x-api-key": "${user_config.exa_api_key}" }
    },
    "exa-agent": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp?tools=agent_run",
      "headers": { "x-api-key": "${user_config.exa_api_key}" }
    }
  }
}
